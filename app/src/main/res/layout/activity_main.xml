<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CallerID Setup"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnGrantPermissions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Grant Call &amp; Contact Permissions"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSetDefaultApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Set as Default Caller ID App"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOverlayPermission"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Allow Display Over Other Apps"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnSyncContacts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="4. Sync My Contacts to Database" />

</LinearLayout>
